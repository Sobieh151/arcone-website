# Copy to .env.local and fill in to enable the contact form (see
# src/app/api/contact/route.ts). Nothing here has a working default —
# the form fails gracefully (with a mailto: fallback) until it's set.

# Required. Get one at https://resend.com
RESEND_API_KEY=

# Optional overrides — default to content/contact.ts's email and
# Resend's sandbox sender respectively.
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
