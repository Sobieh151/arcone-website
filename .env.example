# Copy to .env.local and fill in to enable the contact form (see
# src/components/contact/contact-form.tsx). Nothing here has a working
# default — the form fails gracefully (with a mailto: fallback) until
# it's set.
#
# The /start form posts straight from the browser to Formspree instead of
# a Next.js API route — that setup predates the server build and is kept
# as-is because it already works.

# Required. Sign up at https://formspree.io, create a form, and use its
# ID (the part after /f/ in the endpoint Formspree gives you).
# Must be NEXT_PUBLIC_-prefixed so Next inlines it into the client bundle
# at build time — the form reads it in the browser, not on a server.
NEXT_PUBLIC_FORMSPREE_FORM_ID=
